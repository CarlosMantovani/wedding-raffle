MERCADO_PAGO_CIRCUIT_OPEN_DURATION_MILLIS=30000
MERCADO_PAGO_BULKHEAD_MAX_CONCURRENT_CALLS=10
MERCADO_PAGO_BULKHEAD_MAX_WAIT_MILLIS=250

