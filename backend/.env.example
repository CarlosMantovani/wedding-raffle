SPRING_FLYWAY_PLACEHOLDERS_ADMIN_USERNAME=admin
SPRING_FLYWAY_PLACEHOLDERS_ADMIN_PASSWORD_HASH=$2a$12$replace_with_a_bcrypt_hash_value_here

