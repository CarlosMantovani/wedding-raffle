MERCADO_PAGO_FAILURE_URL=http://localhost:5173/payment-return/failure
MERCADO_PAGO_PENDING_URL=http://localhost:5173/payment-return/pending
MERCADO_PAGO_CONNECT_TIMEOUT_MILLIS=2000
MERCADO_PAGO_READ_TIMEOUT_MILLIS=5000
MERCADO_PAGO_CALL_TIMEOUT_MILLIS=18000
MERCADO_PAGO_CONNECTION_REQUEST_TIMEOUT_MILLIS=500
MERCADO_PAGO_MAX_CONNECTIONS=10
MERCADO_PAGO_RETRY_MAX_ATTEMPTS=3
MERCADO_PAGO_RETRY_DELAY_MILLIS=250
MERCADO_PAGO_RETRY_MULTIPLIER=2
